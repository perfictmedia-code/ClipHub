# =====================================
# DATABASE CONFIGURATION
# =====================================
DATABASE_URL=postgresql://cliphub:password@localhost:5432/cliphub_db
REDIS_URL=redis://localhost:6379

# =====================================
# SERVER CONFIGURATION
# =====================================
ENVIRONMENT=development
SECRET_KEY=your-super-secret-key-change-in-production
API_PORT=8000
API_HOST=0.0.0.0
FRONTEND_URL=http://localhost:3000

# =====================================
# AWS S3 CONFIGURATION (Optional)
# =====================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=cliphub-videos
AWS_S3_REGION=us-east-1

# =====================================
# EMAIL CONFIGURATION
# =====================================
EMAIL_PROVIDER=smtp  # smtp, sendgrid, mailgun
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=ClipHub
SMTP_FROM_EMAIL=noreply@cliphub.com

# =====================================
# JWT CONFIGURATION
# =====================================
JWT_SECRET=your-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
REFRESH_TOKEN_EXPIRATION_DAYS=30

# =====================================
# VIDEO PROCESSING
# =====================================
MAX_VIDEO_SIZE_MB=500
MAX_VIDEO_DURATION_MINUTES=10
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv,webm,flv,wmv
ENABLE_VIDEO_TRANSCODING=true
PROCESSING_QUEUE_WORKERS=4

# =====================================
# AI/ML CONFIGURATION
# =====================================
ENABLE_AUTO_CATEGORIZATION=true
CATEGORIZATION_MODEL=tensorflow  # tensorflow, pytorch, custom
QUALITY_ANALYSIS_ENABLED=true
CONTENT_MODERATION_ENABLED=true

# =====================================
# LOGGING & MONITORING
# =====================================
LOG_LEVEL=INFO
SENTRY_DSN=
LOGROCKET_ID=

# =====================================
# CORS & SECURITY
# =====================================
CORS_ORIGINS=http://localhost:3000,https://cliphub.com
ALLOWED_HOSTS=localhost,127.0.0.1,cliphub.com

# =====================================
# ADMIN CONFIGURATION
# =====================================
ADMIN_EMAIL=admin@cliphub.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# =====================================
# STORAGE PATHS
# =====================================
UPLOAD_DIR=./uploads
TEMP_DIR=./temp
LOG_DIR=./logs

# =====================================
# PAGINATION
# =====================================
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# =====================================
# RATE LIMITING
# =====================================
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD_SECONDS=60
